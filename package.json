{
	"name": "n8n-nodes-plane",
	"version": "0.1.0",
	"description": "n8n community nodes for Plane.so (projects, work items, cycles, and full REST API coverage)",
	"license": "MIT",
	"homepage": "https://github.com/planeso/planeso-n8n-nodes#readme",
	"keywords": [
		"n8n-community-node-package",
		"plane",
		"plane.so",
		"project-management"
	],
	"author": {
		"name": "planeso-n8n-nodes",
		"email": "planeso-n8n-nodes@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/planeso/planeso-n8n-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PlaneApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Plane/Plane.node.js",
			"dist/nodes/Plane/PlaneTrigger.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^20.19.0",
		"@eslint/js": "^10.0.1",
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"n8n-workflow": "*",
		"prettier": "3.8.1",
		"release-it": "19.2.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"n8n-nodes-plane": "file:test/n8n-nodes-plane-0.1.0.tgz"
	}
}
